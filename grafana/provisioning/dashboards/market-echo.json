          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT symbol, count() AS news, avg(sentiment_score) AS avg_sentiment,\n       countIf(sentiment_score >= 0.05) / count() * 100 AS positive_pct,\n       countIf(sentiment_score <= -0.05) / count() * 100 AS negative_pct\nFROM market_echo.news_events\nWHERE $__timeFilter(ts)\nGROUP BY symbol\nORDER BY avg_sentiment DESC",
