          "rawSql": "WITH per_news AS (\n    SELECT symbol, news_ts, any(sentiment_score) AS s,\n           (avgIf(price, is_before = 0) / avgIf(price, is_before = 1) - 1) * 100 AS move\n    FROM market_echo.sentiment_impact\n    WHERE $__timeFilter(news_ts)\n    GROUP BY symbol, news_ts\n    HAVING countIf(is_before = 1) > 0 AND countIf(is_before = 0) > 0\n    ORDER BY abs(move) DESC\n    LIMIT 10\n)\nSELECT p.symbol AS symbol,\n       formatDateTime(p.news_ts, '%m-%d %H:%i', 'America/New_York') AS time_et,\n       p.s AS sentiment,\n       p.move AS move_pct,\n       if(abs(p.s) < 0.05, -1, toInt8(sign(p.s) = sign(p.move))) AS matched,\n       any(n.headline) AS headline\nFROM per_news p\nLEFT JOIN market_echo.news_events n ON n.symbol = p.symbol AND n.ts = p.news_ts\nGROUP BY p.symbol, p.news_ts, p.s, p.move\nORDER BY abs(p.move) DESC",
