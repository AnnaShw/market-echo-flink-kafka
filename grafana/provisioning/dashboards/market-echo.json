            "uid": "PDEE91DDB90597936"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT time, symbol, (price / first_value(price) OVER (PARTITION BY symbol ORDER BY time) - 1) * 100 AS change\nFROM (\n    SELECT $__timeInterval(ts) AS time, symbol, avg(price) AS price\n    FROM market_echo.price_ticks\n    WHERE $__timeFilter(ts)\n    GROUP BY time, symbol\n)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Price change since start of range",
      "type": "timeseries"
