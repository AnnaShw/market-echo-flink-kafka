          "queryType": "sql",
          "rawSql": "SELECT symbol, argMax(price, ts) AS last_price, (argMax(price, ts) / argMin(price, ts) - 1) * 100 AS change_pct\nFROM market_echo.price_ticks\nWHERE $__timeFilter(ts)\nGROUP BY symbol",
